{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://mobisentra.dev/schemas/events/v0/detection.schema.json",
  "title": "Per-frame detection payload (v0)",
  "description": "`data` payload for org.mobisentra.detection.* — lightweight per-frame person detections (debug/analytics path; not alerts).",
  "type": "object",
  "additionalProperties": true,
  "required": ["camera_id", "frame_ts", "detections"],
  "properties": {
    "camera_id": { "type": "string", "minLength": 1 },
    "frame_ts": { "type": "string", "format": "date-time" },
    "detections": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["track_id", "bbox", "conf"],
        "properties": {
          "track_id": { "type": "integer", "minimum": 0 },
          "class": { "type": "string", "default": "person" },
          "bbox": {
            "type": "array",
            "minItems": 4,
            "maxItems": 4,
            "items": { "type": "number", "minimum": 0, "maximum": 1 },
            "description": "[x1, y1, x2, y2] normalized to frame size"
          },
          "conf": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    }
  }
}
